/training/runtime/.venv/
/training/build/
/training/dist/
/training/datasets/
/training/local.json
/scripts/sd-scripts/

# Models live in a separately managed shared tree
/models

# Generated images, caches, logs, and temporary state
/bucket/
/tmp/
/scripts/install_status.txt
**/__pycache__/
*.py[cod]
*.log

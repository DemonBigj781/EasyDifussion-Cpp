ARG UBUNTU_VERSION=24.04
FROM ubuntu:${UBUNTU_VERSION}

ARG DEBIAN_FRONTEND=noninteractive
ARG OPENVINO_VERSION=latest
ARG UBUNTU_VERSION=24.04
ARG PYTHON_VERSION=none
ARG PYTORCH_VERSION=none
ARG PYTORCH_INDEX_URL=none

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

LABEL org.opencontainers.image.title="EasyDifussion-Cpp 050 OpenVINO Toolchain" \
      io.easydifussion.openvino.version="${OPENVINO_VERSION}" \
      io.easydifussion.ubuntu.version="${UBUNTU_VERSION}" \
      io.easydifussion.python.version="${PYTHON_VERSION}" \
      io.easydifussion.pytorch.version="${PYTORCH_VERSION}"

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc g++ clang cmake ninja-build pkg-config git ca-certificates curl wget gnupg \
    libomp-dev libtbb-dev libnuma-dev libhwloc-dev \
    make libssl-dev zlib1g-dev libbz2-dev libreadline-dev libsqlite3-dev llvm \
    libncurses-dev xz-utils tk-dev libxml2-dev libxmlsec1-dev libffi-dev liblzma-dev \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /etc/apt/keyrings \
    && wget -qO- https://apt.repos.intel.com/openvino/2025/GPG-PUB-KEY-INTEL-OPENVINO-2025 | gpg --dearmor > /etc/apt/keyrings/openvino.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/openvino.gpg] https://apt.repos.intel.com/openvino/2025 ubuntu24 main" > /etc/apt/sources.list.d/intel-openvino.list \
    && apt-get update \
    && if [ "$OPENVINO_VERSION" = "latest" ]; then \
         apt-get install -y --no-install-recommends openvino; \
       else \
         resolved="$(apt-cache madison openvino | awk '{print $3}' | grep -E "^${OPENVINO_VERSION//./\\.}([.-]|$)" | head -n1)"; \
         test -n "$resolved" || { echo "No OpenVINO package matches ${OPENVINO_VERSION}" >&2; exit 1; }; \
         echo "[050] resolved OpenVINO ${OPENVINO_VERSION} -> ${resolved}"; \
         apt-get install -y --no-install-recommends "openvino=${resolved}"; \
       fi \
    && rm -rf /var/lib/apt/lists/*

ENV PYENV_ROOT="/root/.pyenv"
ENV PATH="/root/.pyenv/bin:/root/.pyenv/shims:${PATH}"

RUN git clone --depth 1 https://github.com/pyenv/pyenv.git "$PYENV_ROOT" \
    && if [ "$PYTHON_VERSION" != "none" ]; then \
         pyenv install "$PYTHON_VERSION" \
         && pyenv global "$PYTHON_VERSION" \
         && python -m ensurepip --upgrade \
         && python -m pip install --upgrade pip setuptools wheel; \
       fi

RUN if [ "$PYTORCH_VERSION" != "none" ]; then \
      if [ "$PYTHON_VERSION" = "none" ]; then echo 'PyTorch requires Python' >&2; exit 1; fi; \
      if [ "$PYTORCH_INDEX_URL" = "none" ]; then \
        python -m pip install "torch==${PYTORCH_VERSION}"; \
      else \
        python -m pip install "torch==${PYTORCH_VERSION}" --index-url "$PYTORCH_INDEX_URL"; \
      fi; \
    fi

RUN printf '%s\n' \
    'export PYENV_ROOT="$HOME/.pyenv"' \
    'export PATH="$PYENV_ROOT/bin:$PYENV_ROOT/shims:$PATH"' \
    'if command -v pyenv >/dev/null 2>&1; then eval "$(pyenv init -)"; fi' \
    > /etc/profile.d/pyenv.sh

RUN set -eux; \
    header="$(find /usr /opt -path '*/openvino/openvino.hpp' -print -quit 2>/dev/null)"; \
    test -n "$header"; \
    pkg-config --exists openvino || find /usr /opt -name 'OpenVINOConfig.cmake' -print -quit | grep -q .; \
    printf '#include <openvino/openvino.hpp>\nint main(){ ov::Core core; return 0; }\n' > /tmp/openvino-test.cpp; \
    cmake_dir="$(dirname "$(find /usr /opt -name 'OpenVINOConfig.cmake' -print -quit 2>/dev/null)")"; \
    printf 'cmake_minimum_required(VERSION 3.16)\nproject(openvino_test LANGUAGES CXX)\nfind_package(OpenVINO REQUIRED)\nadd_executable(openvino-test openvino-test.cpp)\ntarget_link_libraries(openvino-test PRIVATE openvino::runtime)\n' > /tmp/CMakeLists.txt; \
    cmake -S /tmp -B /tmp/build -GNinja ${cmake_dir:+-DOpenVINO_DIR="$cmake_dir"}; \
    cmake --build /tmp/build; \
    /tmp/build/openvino-test; \
    if [ "$PYTHON_VERSION" != "none" ]; then python --version; fi; \
    if [ "$PYTORCH_VERSION" != "none" ]; then python -c 'import torch; print(torch.__version__)'; fi; \
    echo "[050 verify] OpenVINO ${OPENVINO_VERSION} / Ubuntu ${UBUNTU_VERSION} validation complete"

CMD ["/bin/bash"]

/*
 * Easy Diffusion mobile layout test build.
 * Keeps the Galaxy S7 responsive layout while removing PWA behavior.
 */
(function mobileLayoutOnlyPlugin() {
    "use strict"

    const VERSION = "1.0.1-pwa-disabled-test"
    const STYLE_ID = "easy-diffusion-mobile-layout-style"
    const CACHE_PREFIX = "easy-diffusion-mobile-pwa-"

    if (document.documentElement.dataset.mobileLayoutOnlyLoaded === VERSION) {
        return
    }
    document.documentElement.dataset.mobileLayoutOnlyLoaded = VERSION
    document.documentElement.classList.add("ed-mobile-pwa")
    document.documentElement.classList.remove("ed-secure-context", "ed-insecure-context")

    function configureViewport() {
        let viewport = document.querySelector('meta[name="viewport"]')
        if (!viewport) {
            viewport = document.createElement("meta")
            viewport.name = "viewport"
            document.head.appendChild(viewport)
        }
        viewport.content = "width=device-width, initial-scale=1, viewport-fit=cover"
    }

    function loadMobileStyles() {
        const oldStylesheet = document.getElementById("easy-diffusion-mobile-pwa-style")
        if (oldStylesheet) {
            oldStylesheet.remove()
        }
        if (!document.getElementById(STYLE_ID)) {
            const stylesheet = document.createElement("link")
            stylesheet.id = STYLE_ID
            stylesheet.rel = "stylesheet"
            stylesheet.href = `/plugins/user/mobile-layout-safe.css?v=${VERSION}`
            document.head.appendChild(stylesheet)
        }
    }

    function removePwaDocumentElements() {
        document.querySelectorAll('link[rel="manifest"]').forEach(function (link) {
            if ((link.getAttribute("href") || "").indexOf("mobile-pwa") !== -1) {
                link.remove()
            }
        })
        document.querySelectorAll("link[data-mobile-pwa-apple-icon]").forEach(function (link) {
            link.remove()
        })
        ;[
            "application-name",
            "apple-mobile-web-app-capable",
            "apple-mobile-web-app-status-bar-style",
            "apple-mobile-web-app-title",
            "mobile-web-app-capable",
        ].forEach(function (name) {
            const meta = document.querySelector(`meta[name="${name}"]`)
            if (meta) {
                meta.remove()
            }
        })
        ;[
            "#mobile-pwa-install-card",
            "#mobile-pwa-install-banner",
            "#mobile-pwa-network-status",
            "#mobile-pwa-back-to-prompt",
        ].forEach(function (selector) {
            const element = document.querySelector(selector)
            if (element) {
                element.remove()
            }
        })
    }

    function disablePwaRuntime() {
        if ("serviceWorker" in navigator) {
            navigator.serviceWorker.getRegistrations()
                .then(function (registrations) {
                    return Promise.all(registrations.map(function (registration) {
                        return registration.unregister()
                    }))
                })
                .then(function () {
                    console.info("[Mobile Layout] PWA service worker unregistered for test.")
                })
                .catch(function (error) {
                    console.warn("[Mobile Layout] Could not unregister service worker.", error)
                })
        }
        if ("caches" in window) {
            caches.keys()
                .then(function (keys) {
                    return Promise.all(
                        keys
                            .filter(function (key) {
                                return key.indexOf(CACHE_PREFIX) === 0
                            })
                            .map(function (key) {
                                return caches.delete(key)
                            })
                    )
                })
                .catch(function (error) {
                    console.warn("[Mobile Layout] Could not clear PWA cache.", error)
                })
        }
    }

    const phoneQuery = window.matchMedia("(max-width: 700px)")

    function updatePhoneMode() {
        document.body.classList.toggle("ed-phone-ui", phoneQuery.matches)
        document.body.classList.remove("ed-standalone")
    }

    function updateVisualViewport() {
        const viewport = window.visualViewport
        const height = viewport ? viewport.height : window.innerHeight
        document.documentElement.style.setProperty(
            "--ed-mobile-viewport-height",
            `${Math.round(height)}px`
        )
    }

    configureViewport()
    loadMobileStyles()
    removePwaDocumentElements()
    disablePwaRuntime()
    updatePhoneMode()
    updateVisualViewport()

    if (typeof phoneQuery.addEventListener === "function") {
        phoneQuery.addEventListener("change", updatePhoneMode)
    } else if (typeof phoneQuery.addListener === "function") {
        phoneQuery.addListener(updatePhoneMode)
    }
    window.addEventListener("resize", updateVisualViewport, { passive: true })
    window.addEventListener("orientationchange", updateVisualViewport, { passive: true })
    if (window.visualViewport) {
        window.visualViewport.addEventListener("resize", updateVisualViewport, { passive: true })
    }

    console.info(`[Mobile Layout] Responsive UI ${VERSION} loaded; PWA is disabled.`)
})()

/*
 * Minimal Galaxy S7 layout overrides.
 * Deliberately does not change root height, overflow, position, or touch-action.
 */

html.ed-mobile-pwa {
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
}

@media screen and (max-width: 700px) {
    html.ed-mobile-pwa,
    html.ed-mobile-pwa body {
        width: 100%;
        max-width: 100%;
    }

    html.ed-mobile-pwa body.ed-phone-ui #editor,
    html.ed-mobile-pwa body.ed-phone-ui #preview,
    html.ed-mobile-pwa body.ed-phone-ui #editor-settings,
    html.ed-mobile-pwa body.ed-phone-ui #z-tipo-panel {
        width: 100%;
        min-width: 0;
        max-width: 100%;
    }

    html.ed-mobile-pwa body.ed-phone-ui #editor {
        padding: 10px 8px;
    }

    html.ed-mobile-pwa body.ed-phone-ui #editor-inputs .row {
        min-width: 0;
        padding-bottom: 12px;
    }

    html.ed-mobile-pwa body.ed-phone-ui #prompt,
    html.ed-mobile-pwa body.ed-phone-ui #negative_prompt {
        width: 100%;
        min-height: 88px;
        padding: 9px;
        font-size: 16px;
        line-height: 1.35;
        resize: vertical;
    }

    html.ed-mobile-pwa body.ed-phone-ui button,
    html.ed-mobile-pwa body.ed-phone-ui .button {
        min-height: 40px;
    }

    html.ed-mobile-pwa body.ed-phone-ui #makeImage {
        width: 100%;
        min-height: 52px;
        height: auto;
        margin-top: 4px;
        font-size: 16px;
        font-weight: 800;
    }

    html.ed-mobile-pwa body.ed-phone-ui #z-tipo-panel {
        margin: 10px 0 12px;
        padding: 8px;
    }

    html.ed-mobile-pwa body.ed-phone-ui #z-tipo-panel .collapsible-content {
        width: 100%;
        max-width: 100%;
        padding-left: 0;
    }

    html.ed-mobile-pwa body.ed-phone-ui #z-tipo-panel [style*="grid-template-columns"] {
        grid-template-columns: minmax(0, 1fr) !important;
    }

    html.ed-mobile-pwa body.ed-phone-ui #z-tipo-panel input,
    html.ed-mobile-pwa body.ed-phone-ui #z-tipo-panel select,
    html.ed-mobile-pwa body.ed-phone-ui #z-tipo-panel textarea {
        width: 100%;
        min-width: 0;
        max-width: 100%;
        font-size: 16px;
    }

    html.ed-mobile-pwa body.ed-phone-ui .image-input-buttons,
    html.ed-mobile-pwa body.ed-phone-ui #render-buttons {
        flex-wrap: wrap;
    }

    html.ed-mobile-pwa body.ed-phone-ui .imgItem,
    html.ed-mobile-pwa body.ed-phone-ui .imgContainer,
    html.ed-mobile-pwa body.ed-phone-ui .imgContainer > img {
        width: 100% !important;
        max-width: 100%;
        height: auto !important;
    }

    html.ed-mobile-pwa body.ed-phone-ui #footer {
        padding: 12px 8px;
    }
}

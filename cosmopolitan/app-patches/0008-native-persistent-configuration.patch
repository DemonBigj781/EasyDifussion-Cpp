 void Server::setupRoutes() {
     cosmo_register_ui_routes(app_);
+    auto get_config = []() {
+        try {
+            crow::response response(200, cosmo_config_document());
+            response.set_header("Content-Type", "application/json");
+            response.set_header("Cache-Control", "no-store");
+            return response;
+        } catch (const std::exception& error) {
+            return request_error(500, error.what());
+        }
+    };
+    auto update_config = [this](const crow::request& req) {
+        if (inference_dispatcher_.busy()) return request_error(409, "A native generation request is active");
+        std::unique_lock<std::mutex> gate(generation_mutex_, std::try_to_lock);
+        if (!gate.owns_lock()) return request_error(409, "A native generation request is active");
+        try {
+            crow::response response(200, cosmo_config_update(req.body));
+            response.set_header("Content-Type", "application/json");
+            response.set_header("Cache-Control", "no-store");
+            return response;
+        } catch (const std::invalid_argument& error) {
+            return request_error(400, error.what());
+        } catch (const std::exception& error) {
+            return request_error(500, error.what());
+        }
+    };
+    CROW_ROUTE(app_, "/get/app_config").methods("GET"_method)(get_config);
+    CROW_ROUTE(app_, "/v1/sdapi/v1/config").methods("GET"_method)(get_config);
+    CROW_ROUTE(app_, "/app_config").methods("POST"_method)(update_config);
+    CROW_ROUTE(app_, "/v1/sdapi/v1/config").methods("POST"_method)(update_config);
+
     // Ping endpoint
     CROW_ROUTE(app_, "/v1/internal/ping").methods("GET"_method)([this]() { return handlePing(); });
 

+
+struct CosmoPendingResponse {
+    crow::response* response = nullptr;
+    asio::io_service* io = nullptr;
+    std::string body;
+    crow::response result;
+};
+
+void Server::dispatchGeneration(const crow::request& req, crow::response& response, int kind) {
+    if (!req.io_service) {
+        response = request_error(500, "Native generation has no HTTP executor");
+        response.end();
+        return;
+    }
+    auto pending = std::make_shared<CosmoPendingResponse>();
+    pending->response = &response;
+    pending->io = req.io_service;
+    pending->body = req.body; // No request/parser storage is borrowed by the worker.
+    {
+        std::lock_guard<std::mutex> lock(pending_response_mutex_);
+        pending_responses_.push_back(pending);
+    }
+    auto alive = response_delivery_alive_;
+    bool accepted = false;
+    try {
+        accepted = inference_dispatcher_.try_submit([this, pending, kind] {
+            try {
+                crow::request copy;
+                copy.body = pending->body;
+                switch (kind) {
+                    case 0: pending->result = handleTxt2Img(copy); break;
+                    case 1: pending->result = handleImg2Img(copy); break;
+                    case 2: pending->result = handleTxt2Video(copy); break;
+                    case 3: pending->result = handleImg2Video(copy); break;
+                    default: pending->result = request_error(500, "Invalid native generation route"); break;
+                }
+            } catch (const std::exception& error) {
+                pending->result = request_error(500, sd_generation_error_message(error.what()));
+            } catch (...) {
+                pending->result = request_error(500, "Unknown native generation failure");
+            }
+        }, [this, pending, alive] {
+            // app_ owns this io_service until after finishAsyncRequests joins
+            // the coordinator. Posting after stop is safe; shutdown abandons
+            // any response whose queued completion could not execute.
+            pending->io->post([this, pending, alive] {
+                if (!alive->load()) return;
+                crow::response* response = nullptr;
+                {
+                    std::lock_guard<std::mutex> lock(pending_response_mutex_);
+                    response = pending->response;
+                    pending->response = nullptr;
+                    auto& items = pending_responses_;
+                    items.erase(std::remove(items.begin(), items.end(), pending), items.end());
+                }
+                if (response) {
+                    *response = std::move(pending->result);
+                    response->end();
+                }
+            });
+        });
+    } catch (const std::exception& error) {
+        response = request_error(500, error.what());
+    }
+    if (!accepted) {
+        {
+            std::lock_guard<std::mutex> lock(pending_response_mutex_);
+            pending->response = nullptr;
+            auto& items = pending_responses_;
+            items.erase(std::remove(items.begin(), items.end(), pending), items.end());
+        }
+        if (response.code == 200) response = request_error(409, "A native generation request is active");
+        response.end();
+    }
+}
+
+void Server::finishAsyncRequests() {
+    // Call only after Crow's I/O loops have joined (or before they start).
+    response_delivery_alive_->store(false);
+    inference_dispatcher_.close_admission();
+    image_generator_->interrupt();
+    inference_dispatcher_.shutdown();
+    std::vector<std::shared_ptr<CosmoPendingResponse>> pending;
+    {
+        std::lock_guard<std::mutex> lock(pending_response_mutex_);
+        pending.swap(pending_responses_);
+    }
+    for (auto& item : pending) {
+        crow::response* response = item->response;
+        item->response = nullptr;
+        // end() needs live Crow worker-local callbacks. Those workers stopped;
+        // abandon only releases the connection ownership, without I/O.
+        if (response) response->abandon();
+    }
 }
 

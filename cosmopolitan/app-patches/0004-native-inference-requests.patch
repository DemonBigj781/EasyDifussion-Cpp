+    for (const auto& key : overrides.keys()) {
+        if (key == "sd_model_checkpoint" && overrides[key].t() == crow::json::type::String) {
+            merged[key] = overrides[key].s();
+        } else if (key == "forge_additional_modules" && overrides[key].t() == crow::json::type::List &&
+                   overrides[key].size() == 0) {

set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_C_COMPILER "$ENV{COSMO_BUILD_TOOLS}/cc")
set(CMAKE_CXX_COMPILER "$ENV{COSMO_BUILD_TOOLS}/cxx")
set(CMAKE_ASM_COMPILER "$ENV{COSMO_BUILD_TOOLS}/cc")
set(CMAKE_AR "$ENV{COSMO_BUILD_TOOLS}/ar")
set(CMAKE_RANLIB "$ENV{COSMO_BUILD_TOOLS}/ranlib")
set(CMAKE_STRIP "$ENV{COSMO_BUILD_TOOLS}/strip")
set(CMAKE_C_FLAGS_INIT "-march=x86-64 -mtune=generic -ffunction-sections -fdata-sections -fno-omit-frame-pointer")
set(CMAKE_CXX_FLAGS_INIT "-march=x86-64 -mtune=generic -ffunction-sections -fdata-sections -fno-omit-frame-pointer")
set(CMAKE_POSITION_INDEPENDENT_CODE OFF)
set(CMAKE_FIND_ROOT_PATH "$ENV{COSMO_SDK}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

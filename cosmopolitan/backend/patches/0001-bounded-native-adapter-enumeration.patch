+/// Application extension: unlike upstream's unbounded output array, this
+/// function writes at most `capacity` handles and returns the full new count.
+/// The caller owns exactly min(capacity, count) references if output is nonnull.
+#[no_mangle]
+pub unsafe extern "C" fn cosmo_wgpu_instance_enumerate_adapters(
+    instance: native::WGPUInstance,
+    options: Option<&native::WGPUInstanceEnumerateAdapterOptions>,
+    capacity: usize,
+    adapters: *mut native::WGPUAdapter,
+) -> usize {
+    let instance = instance.as_ref().expect("invalid instance");
+    let context = &instance.context;
+    let inputs = match options {
+        Some(options) => map_instance_backend_flags(options.backends as native::WGPUInstanceBackend),
+        None => wgt::Backends::all(),
+    };
+    cosmo_adapter_enumeration::cosmo_transfer_adapters(
+        context.enumerate_adapters(inputs), capacity, adapters,
+        |id| Arc::into_raw(Arc::new(WGPUAdapterImpl { context: context.clone(), id })),
+        |id| context.adapter_drop(id),
+    )
+}

# Linux-only local-fork defaults. Change listen_port if 10000 is already in use.
net:
  listen_port: 10000
  listen_to_network: false

# Multi GPU setup
render_devices: auto

# Set open_browser_on_start to false to disable opening a new browser tab on each restart
ui:
  open_browser_on_start: false

backend_config:
  auto_update: false
# Optional explicit Perchance v1 AppImage/launcher path. If omitted, Easy
# Diffusion checks tools/perchance, perchance, the repository root, and the
# current user's bin directories.
# perchance:
#   launcher: /path/to/Perchance-1.0.0-x86_64.AppImage
# Advanced backend overrides are applied by scripts/check_modules.py.
#   # Extra backend flags (example: cross-attention optimizations)
#   COMMANDLINE_ARGS: "--opt-split-attention"
#   # Force full precision (float32). Can help if you see corrupted/black outputs on some GPUs/backends.
#   FORCE_FULL_PRECISION: "1"
# Optional per-family model directories. Relative paths are resolved below
# models_dir. A YAML list lets a family scan more than one directory.
# directories:
#   checkpoints: checkpoints
#   vae: vae
#   taesdvae: VAE-taesd
#   lora: lora
#   embeddings: embeddings
#   controlnet: controlnet
#   controlnet-lite: Controlnet_LITE
#   text-encoder: text-encoder
#   video: [SVD, diffusion_models, mochi, lighttricks]
#
# Set force_save_path to enforce an auto save path. Clients will not be able to change or
# disable auto save when this option is set. Please adapt the path in the examples to your
# needs.
# Linux:
# force_save_path: /data/easy-diffusion-images/
# Saved-image names support $n (five-digit folder counter), $p (first 50
# prompt characters), $s (seed), $ts/$tsb64 (timestamp IDs), and the date/time
# placeholders $yyyy, $MM, $dd, $HH, $mm, and $ss. Put $n first so an existing
# directory can resume from its highest counter.
# filename_format: "$n_$p_$tsb64"
